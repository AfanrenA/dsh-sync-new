// ======================================================================
// 碰撞层枚举 - 所有碰撞对象用这个定义"属于哪一层"
// ======================================================================

enum COLLISION_LAYER {
    NONE = 0,
    WALL = 1 << 0,      // 1
    CHEST = 1 << 1,     // 2
    ENTITY = 1 << 2,    // 4  (玩家/敌人)
    PROJECTILE = 1 << 3,// 8
    PICKUP = 1 << 4,    // 16 (掉落物)
    ALL = 31
}