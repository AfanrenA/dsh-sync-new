// ======================================================================
// obj_hitbox - Create 事件
// 近战攻击碰撞盒
// 
// V3 设计原则：
//   1. 只声明变量，所有值由 scr_hitbox_create 设置
//   2. 不依赖任何外部逻辑，保持独立
// ======================================================================

// ---- 基础属性（由 scr_hitbox_create 设置） ----
weapon_ref = noone;      // 绑定的武器实例
damage = 0;              // 伤害值
owner = noone;           // 攻击者（玩家或敌人）
can_deflect = false;     // 是否可以抵消飞行物

// ---- 生命周期 ----
life = 0;                // 存活帧数（由数据表配置）
max_life = 0;            // 最大寿命（用于进度计算）
extra_life = 0;          // hack 武器额外延迟帧数

// ---- 碰撞检测 ----
hit_list = ds_list_create();     // 已命中敌人列表（防重复）
hit_radius = 20;                 // 碰撞半径（可由数据表配置）