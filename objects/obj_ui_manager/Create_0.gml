/// @description UI 管理器 - 初始化

// ===== UI 分辨率（固定尺寸，自动缩放） =====
ui_width = 1280;
ui_height = 720;
display_set_gui_size(ui_width, ui_height);

// ===== 血量条 =====
ui_hp_x = 40;
ui_hp_y = 30;
ui_hp_width = 200;
ui_hp_height = 24;

// ===== 信息卡片（血条下方，属性面板上方） =====
ui_card_x = 40;
ui_card_y = 65;
ui_card_gap = 12;
ui_card_width = 120;
ui_card_height = 32;

// ===== 属性面板 =====
ui_stats_x = 40;
ui_stats_y = 110;
ui_stats_line_h = 28;

// ===== 颜色配置 =====
ui_color_hp_bg = c_black;
ui_color_hp_fg = c_red;
ui_color_text = c_white;