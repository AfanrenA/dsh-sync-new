// ============================================================
// 1. 父武器存活检查
// ============================================================
if (!instance_exists(parent_weapon)) {
    instance_destroy();
    exit;
}

// ============================================================
// 2. ★★★ 如果父武器被拾取（不再掉落），光晕自动销毁 ★★★
// ============================================================
if (!parent_weapon.is_dropped) {
    instance_destroy();
    exit;
}

// ============================================================
// 3. 跟随父武器位置
// ============================================================
x = parent_weapon.x;
y = parent_weapon.y;

// ============================================================
// 4. 呼吸脉冲动画
// ============================================================
pulse_timer += 0.06;
image_alpha = 0.2 + 0.15 * sin(pulse_timer);
image_xscale = (0.95 + 0.05 * sin(pulse_timer * 0.7)) * (image_xscale / abs(image_xscale) || 1);
image_yscale = image_xscale;