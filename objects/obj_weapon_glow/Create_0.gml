// ======================================================================
// obj_weapon_glow - 创建事件（V3 标准）
// ======================================================================
// 职责：初始化光晕对象，等待 Draw 事件绘制

parent_weapon = noone;      // 绑定的武器实例
pulse_timer = random(360);  // 呼吸动画随机初始相位
glow_radius = 32;           // 基础光晕半径
depth = -10;                // ★ 确保在武器上方（数字越小越靠上）
image_speed = 0;            // 不使用精灵动画
visible = true;             // 确保可见