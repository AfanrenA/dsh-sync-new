// ============================================================
// obj_enemy_base - Draw 事件
// 敌人的基础绘制：精灵 + 闪白
// ============================================================

// 1. 先调用父对象（如果有）
event_inherited();

// 2. 画敌人自己的精灵
draw_self();

// 3. 受击闪白（和玩家共用同一个函数）
scr_draw_hit_flash(id);

// 4. 冷却圈（如果敌人需要显示）
scr_draw_cooldown_ring(id);

scr_debug_draw_collision(id);