// ======================================================================
// obj_player_base - Create 事件（V3 标准）
// ======================================================================
/// @description 所有玩家角色的父对象
///
/// 职责：
///   1. 从数据表读取玩家属性（数据驱动）
///   2. 从存档恢复状态
///   3. 初始化玩家特有的运行时变量（输入、UI等）
///   4. ★ 不自动创建武器（由关卡或拾取提供）★
///
/// 继承链：
///   obj_character_base → obj_player_base → obj_player / obj_warrior / obj_mage
/// ======================================================================


// ============================================================
// 1. 继承父对象（血量、速度、武器槽等基础属性）
// ============================================================
event_inherited();


// ============================================================
// 2. 从配置表读取玩家属性（数据驱动）
// ============================================================
var _config = data_player_get();
if (_config != undefined) {
    max_hp = _config.max_hp;
    move_speed = _config.base_speed;
    attack_power = _config.base_attack;
    defense = _config.base_defense;
    attack_speed = _config.base_attack_speed;
    view_enabled = true;
    show_debug_message("📊 玩家配置: HP=" + string(max_hp) + ", 速度=" + string(move_speed));
} else {
    show_debug_message("⚠️ 玩家配置表不存在，使用默认值");
    max_hp = 100;
    move_speed = 4;
    attack_power = 10;
    defense = 0;
    attack_speed = 1;
    view_enabled = true;
}


// ============================================================
// 3. 从存档读取当前状态（如果有）
// ============================================================
var _save = save_player_get();
if (_save != undefined) {
    hp = _save.hp;
    x = _save.x;
    y = _save.y;
    show_debug_message("💾 从存档读取: HP=" + string(hp) + ", 位置=(" + string(x) + ", " + string(y) + ")");
} else {
    hp = max_hp;
    show_debug_message("💾 无存档，使用默认满血");
}


// ============================================================
// 4. 玩家特有：输入和运行时状态
// ============================================================
// ---- 移动 ----
hsp = 0;
vsp = 0;

// ---- 地面检测 ----
grounded = false;
in_air = false;

// ---- 输入状态 ----
input_x = 0;
input_y = 0;

// ---- 冷却圈UI ----
cooldown_max = 0;


// ============================================================
// 5. 玩家出生不自动创建武器（由关卡或拾取提供）
// ============================================================
show_debug_message("🗡️ 玩家出生无武器，等待关卡提供或拾取");


// ============================================================
// ★ 6. 防御性初始化（确保变量存在再保存）★
// ============================================================
if (!variable_instance_exists(id, "current_weapon")) {
    current_weapon = noone;
}
if (!variable_instance_exists(id, "hp")) {
    hp = max_hp;
}

// ============================================================
// 7. 保存存档
// ============================================================
save_player_update();


// ============================================================
// 8. 调试信息
// ============================================================
show_debug_message("✅ 玩家创建完成: HP=" + string(hp) + "/" + string(max_hp) + 
                   ", 武器=" + string(instance_exists(current_weapon) ? current_weapon.weapon_name : "无"));