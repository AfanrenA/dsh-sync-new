// obj_screen_effect Create 事件
/// @description 屏幕边缘效果 + 震动

// ===== 边缘红圈 =====
edge_alpha = 0;
edge_target_alpha = 0;
edge_color = c_red;
edge_radius = 30;
edge_fade_speed = 0.03;

// ===== 白色护盾圈 =====
shield_edge_alpha = 0;
shield_edge_target = 0;
shield_edge_fade_speed = 0.05;

// ===== 屏幕震动 =====
shake_intensity = 0;
shake_duration = 0;
shake_x = 0;
shake_y = 0;

show_debug_message("[SCREEN EFFECT] 初始化完成");