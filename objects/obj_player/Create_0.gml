// ---- 继承父对象（所有初始化都在父对象完成） ----
event_inherited();

// ---- 如果有玩家特有的初始化，放在这里 ----
// 例如：特定的初始位置、特定的初始武器等
// 普通玩家不需要额外逻辑
// ---- 身份标识（用于死亡特效、掉落表等） ----
who = "player";
show_debug_message("🎮 默认玩家实例已创建");