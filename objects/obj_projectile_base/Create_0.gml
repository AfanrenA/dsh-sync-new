// ======================================================================
// obj_projectile_base - Create 事件（V3 标准 + 碰撞响应）
// ======================================================================
/// @description 飞行物父对象 - 所有子弹、剑气、投掷物的基类
///
/// 职责：
///   1. 声明所有飞行物共用的变量
///   2. 提供模块化扩展点（缩放、重力、跟踪）
///   3. 由子对象覆盖具体参数
///   4. ★ 提供默认碰撞响应函数（由子对象覆盖）★
///
/// 继承链：
///   obj_projectile_base → obj_bullet / obj_slash / obj_thrown_projectile / obj_thrown_dagger
/// ======================================================================


// ============================================================
// 1. 基础属性（由子对象或数据表覆盖）
// ============================================================
direction = 0;           // 飞行方向（角度，0=右）
speed = 8;               // 飞行速度（像素/帧）
damage = 10;             // 伤害值
owner = noone;           // 发射者实例（用于敌我判断）
life = 60;               // 剩余生命（帧）
max_life = 60;           // 最大生命（用于进度计算）


// ============================================================
// 2. 状态标记（由子对象设置）
// ============================================================
is_thrown = false;       // 是否投掷物（影响碰撞逻辑）
is_explosive = false;    // 是否爆炸（影响销毁时行为）


// ============================================================
// 3. 模块引用（由子对象挂载，用于组合行为）
// ============================================================
scale_module = noone;    // 缩放模块实例（如剑气渐大）
gravity_module = noone;  // 重力模块实例（如投掷物抛物线）
tracking_module = noone; // 跟踪模块实例（如追踪弹）


// ============================================================
// 4. 视觉设置（可选）
// ============================================================
image_angle = direction; // 精灵朝向
image_speed = 0;         // 不使用精灵自动动画


// ============================================================
// 5. ★★★ 碰撞响应函数（由子对象覆盖）★★★
// ============================================================
/// @description 碰撞响应 - 默认行为（子对象可覆盖）
/// @param {instance} _other 碰撞到的对象
function on_collision(_other) {
    // 默认行为：销毁自己
    show_debug_message("💥 " + string(object_get_name(object_index)) + " 撞到 " + string(_other.object_index) + "，默认销毁");
    instance_destroy();
}


// ============================================================
// 6. 调试日志
// ============================================================
show_debug_message("🚀 " + string(object_get_name(object_index)) + " 已创建，生命: " + string(life));