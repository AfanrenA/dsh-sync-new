/// @description 游戏入口初始化
show_debug_message("🎮 游戏启动！");

// ======================================================================
// 1. 资源数据（游戏货币）
// ======================================================================
global.shards = 0;
global.shard_0s = 0;
global.cores = 0;
global.axe_init_count = 0;
// ======================================================================
// 2. 全局列表（运行时数据）
// ======================================================================
global.dropped_weapons = ds_list_create();  // ★ 这是你漏掉的 ★
show_debug_message("   ✅ global.dropped_weapons 已初始化");

// ======================================================================
// 3. 全局图层配置
// ======================================================================
global.effects_layer = "Effects";
global.particles_layer = "Particles";
global.ui_layer = "UI";
show_debug_message("   ✅ 图层配置完成");

// ======================================================================
// 4. 窗口设置
// ======================================================================
window_set_size(960, 540);
window_set_fullscreen(false);
show_debug_message("   ✅ 窗口设置完成");

show_debug_message("✅ 游戏启动初始化完成！");